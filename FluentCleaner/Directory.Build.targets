<Project>
  <!-- Override Visual Studio Appx tasks for unpackaged WinUI 3 build without Visual Studio UWP workload -->
  <Target Name="CopyLocalFilesOutputGroup" Returns="@(CopyLocalFilesOutputGroupOutput)">
    <ItemGroup>
      <CopyLocalFilesOutputGroupOutput Include="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
  <Target Name="GetMrtPackagingOutputs" Returns="@(PackagingOutputs)" />
  <Target Name="_GetAppxPackagingOutputs" Returns="@(PackagingOutputs)" />
  <Target Name="_GetDefaultResourceLanguage" />
  <Target Name="_GetPackageArchitecture" />
  <Target Name="_GetRecursiveProjectArchitecture" />
  <Target Name="_ValidateConfiguration" />
  <Target Name="_ExpandPriFiles" />

  <!-- Ensure all WindowsAppSDK native and managed assemblies are deployed for unpackaged run -->
  <Target Name="CopyWinAppSDKNativeBinaries" AfterTargets="Build">
    <ItemGroup>
      <WinAppSDKNativeFiles Include="$(PkgMicrosoft_WindowsAppSDK)\runtimes\win-x64\native\**\*.*" />
      <WinAppSDKLibFiles Include="$(PkgMicrosoft_WindowsAppSDK)\lib\net6.0-windows10.0.18362.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WinAppSDKNativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WinAppSDKLibFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
