<Window
    x:Class="FluentCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentCleaner">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native TitleBar: icon + title left, search center, [...] right -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="FluentCleaner"
                  Subtitle="{x:Bind InsiderSubtitle}"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid>
                    <!-- Full search -->
                    <AutoSuggestBox x:Name="TitleSearchBox"
                        x:Uid="SearchBox"
                        MinWidth="160"
                        MaxWidth="280"
                        Width="280"
                        VerticalAlignment="Center"
                        QueryIcon="Find"
                        TextChanged="TitleSearchBox_TextChanged" />

                    <!-- Compact search icon -->
                    <Button x:Name="SearchIconButton"
                        x:Uid="SearchIconButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0">

                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <AutoSuggestBox Width="280"
                                    PlaceholderText="Search…"
                                    QueryIcon="Find"
                                    TextChanged="TitleSearchBox_TextChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <Button x:Name="BtnPageActions" x:Uid="BtnPageActions" Width="32" Height="32" Padding="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PageActionsFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opening="PageActionsFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- NavView sits below TitleBar -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="48"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavCleaner" Content="Cleaner" Tag="Cleaner">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTools" Content="Tools" Tag="Tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAnalyzer" Content="Analyzer" Tag="Analyzer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDeveloper" Content="Developer Cleanup" Tag="Developer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBE8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTerminal" Content="Terminal" Tag="Terminal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCustom" Content="Custom" Tag="Custom">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>