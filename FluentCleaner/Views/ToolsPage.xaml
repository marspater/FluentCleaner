<Page
    x:Class="FluentCleaner.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:FluentCleaner.Views"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Padding="32,26,32,16">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Uid="ToolsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="ToolsSubtitle" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- main split: categories left, cards + output right -->
        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: category selector -->
            <ListView x:Name="listCategories" Grid.Column="0"
                      SelectionMode="Single"
                      SelectionChanged="listCategories_SelectionChanged"
                      Padding="0,0,16,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="ext:ToolsCategory">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                            <FontIcon Glyph="{x:Bind Icon}" FontSize="14"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- right: single active tool widget + live output -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- tool widget card -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="340">
                    <Border Margin="20,0,20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20">
                        <StackPanel Spacing="14">

                            <!-- widget header: icon + title left, folder button right -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblIcon" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock x:Name="lblTitle" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Open Extensions folder"
                                        AutomationProperties.Name="Open Extensions folder"
                                        Click="btnOpenFolder_Click"
                                        Padding="6">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="{ThemeResource SubtleFillColorTertiary}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush"           Color="Transparent" />
                                    </Button.Resources>
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>

                            <!-- description -->
                            <TextBlock x:Name="lblDescription" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- help info bar -->
                            <InfoBar x:Name="infoHelp" Severity="Warning"
                                     IsOpen="False" IsClosable="False">
                                <InfoBar.ActionButton>
                                    <Button x:Name="btnShowHelp" Content="Show help"
                                            Click="btnShowHelp_Click" FontSize="11" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <!-- options dropdown -->
                            <ComboBox x:Name="comboOptions"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select option"
                                      Visibility="Collapsed" />

                            <!-- free-text input -->
                            <TextBox x:Name="textInput"
                                     HorizontalAlignment="Stretch"
                                     PlaceholderText="Enter input (e.g. IDs or raw arguments)"
                                     Visibility="Collapsed" />

                            <!-- attribution link -->
                            <HyperlinkButton x:Name="linkPoweredBy"
                                             Visibility="Collapsed"
                                             FontSize="11" Padding="0"
                                             Click="linkPoweredBy_Click" />

                            <!-- action buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="btnRun" Content="Run"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="btnRun_Click"
                                        Visibility="Collapsed" />
                                <Button x:Name="btnUninstall" Content="Remove"
                                        Click="btnUninstall_Click"
                                        Visibility="Collapsed" />
                            </StackPanel>

                            <ProgressRing x:Name="progressRing"
                                          IsActive="False"
                                          Width="24" Height="24"
                                          HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- output widget card -->
                <Border x:Name="borderOutput" Grid.Row="1"
                        Margin="20,0,20,16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,14">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE756;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- more-options flyout (...) -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" Padding="0"
                                        ToolTipService.ToolTip="More options"
                                        AutomationProperties.Name="More options">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="{ThemeResource SubtleFillColorTertiary}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush"           Color="Transparent" />
                                    </Button.Resources>
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem x:Name="btnClearLog"
                                                            Text="Clear output"
                                                            Click="btnClearLog_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <RichEditBox x:Name="textLog"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         FontFamily="Consolas"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         MinHeight="80"
                                         MaxHeight="360"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>