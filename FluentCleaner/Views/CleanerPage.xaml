<Page
    x:Class="FluentCleaner.Views.CleanerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentCleaner.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <!-- two-card layout: left = entry selector, right = analysis results -->
    <Grid Padding="0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="420" />
            <ColumnDefinition Width="1" />    <!-- divider -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- vertical divider -->
        <Rectangle Grid.Column="1"
                   Width="1"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                   VerticalAlignment="Stretch" />

        <!-- left panel;entry selector -->
        <Grid Grid.Column="0">
                <!-- Loading state: shown while databases are parsing / detecting apps -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Detecting apps…"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Empty state: only when idle and nothing found (IsEmptyAndIdle) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmptyAndIdle, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="36"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Uid="CleanerHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Entry tree: one Expander per category, one row per app inside.
                     Hidden until something is loaded (IsNotEmpty). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,6,0,8"
                              Visibility="{x:Bind ViewModel.IsNotEmpty, Mode=OneWay,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                  Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CleanerCategoryViewModel">

                                <!-- one collapsible group per category (e.g. "Google Chrome") -->
                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                          Margin="8,3,8,0"
                                          Padding="0">

                                    <!-- Category header: name + [...] menu -->
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Name}"
                                                       Style="{StaticResource FC_CardHeaderStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Name}"
                                                       VerticalAlignment="Center" />

                                            <!-- [...] category actions -->
                                            <Button x:Uid="BtnCategoryActions"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FC_SubtleIconButton}"
                                                    Margin="6,0,0,0">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem x:Uid="MenuSelectAll"
                                                                        Command="{x:Bind SelectAllCommand}" />
                                                        <MenuFlyoutItem x:Uid="MenuSelectNone"
                                                                        Command="{x:Bind SelectNoneCommand}" />
                                                        <MenuFlyoutItem x:Uid="MenuSelectDefaults"
                                                                        Command="{x:Bind SelectDefaultsCommand}" />
                                                        <MenuFlyoutSeparator />
                                                        <!-- Tag passes the CategoryViewModel to the click handler -->
                                                        <MenuFlyoutItem x:Uid="MenuAnalyzeCategory"
                                                                        Tag="{x:Bind}"
                                                                        Click="CatAnalyze_Click" />
                                                        <MenuFlyoutItem x:Uid="MenuCleanCategory"
                                                                        Tag="{x:Bind}"
                                                                        Click="CatClean_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Entry rows inside the category -->
                                    <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}"
                                                  Padding="4,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CleanerEntryViewModel">
                                                <!-- Three columns: [checkbox+name] [size after scan] [...] -->
                                                <Grid Padding="2,1" Margin="16,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" /> <!-- size label -->
                                                        <ColumnDefinition Width="Auto" /> <!-- [...] button -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox; Warning tooltip from Winapp2.ini Warning= field.
                                                         Warning icon appears when HasWarning is true. -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                              ToolTipService.ToolTip="{x:Bind Warning}"
                                                              MinWidth="0"
                                                              Padding="6,3">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7BA;"
                                                                      FontSize="11"
                                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="{x:Bind HasWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                                        </StackPanel>
                                                    </CheckBox>

                                                    <!-- SizeText: empty string until this entry has been scanned.
                                                         Updated live by UpdateEntrySize() in the ViewModel. -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind SizeText, Mode=OneWay}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,4,0" />

                                                    <!-- [...] entry actions -->
                                                    <Button x:Uid="BtnEntryActions"
                                                            Grid.Column="2"
                                                            Style="{StaticResource FC_SubtleIconButton}"
                                                            MinWidth="24" MinHeight="24"
                                                            Margin="0,0,2,0">
                                                        <FontIcon Glyph="&#xE712;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="Bottom">
                                                                <MenuFlyoutItem x:Uid="MenuAnalyzeEntry"
                                                                                Tag="{x:Bind}"
                                                                                Click="EntryAnalyze_Click" />
                                                                <MenuFlyoutItem x:Uid="MenuCleanEntry"
                                                                                Tag="{x:Bind}"
                                                                                Click="EntryClean_Click" />
                                                              <MenuFlyoutItem x:Uid="MenuExplainEntry"
                                                                                Tag="{x:Bind}"
                                                                                Click="EntryExplain_Click" />
                                                        </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
        </Grid>

        <!-- right panel;analysis results -->
        <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- results header OR detail header -->
                    <RowDefinition Height="*" />       <!-- results list OR detail list -->
                    <RowDefinition Height="Auto" />    <!-- Unified status + action bar -->
                </Grid.RowDefinitions>

                <!-- real scan progress; fills per finished entry -->
                <ProgressBar Grid.RowSpan="3"
                             VerticalAlignment="Top"
                             Maximum="100"
                             Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                                 Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.RowSpan="3"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Style="{StaticResource FC_CaptionStyle}"
                           Opacity="0.7"
                           Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                               Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Results header; visible while the list is showing (not in detail view) -->
                <Grid Grid.Row="0"
                      Padding="12,10,12,10"
                      Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />  <!-- total size badge -->
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Uid="ResultsHeader"
                               Grid.Column="0"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <!-- Sum of all scanned entries; empty until Analyze finishes -->
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.TotalSize, Mode=OneWay}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Detail header;this replaces results header when a result row is open.
                     Shows back button + entry name + open-folder + delete buttons. -->
                <Grid Grid.Row="0"
                      Padding="12,10,12,10"
                      Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />    <!-- entry name; truncates if too long -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back;so it returns to results list (clears SelectedResultLine) -->
                    <Button x:Uid="BtnBackToResults"
                            Grid.Column="0"
                            Command="{x:Bind ViewModel.ClearDetailCommand}"
                            Width="24" Height="24" Padding="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <!-- SelectedAppName = the AppName of whichever result row was clicked -->
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Cleans only this single entry without touching the rest -->
                    <Button x:Uid="BtnCleanDetail"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.CleanSelectedCommand}"
                            Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Divider below header -->
                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Results list; each row is one scanned app.
                     Click a row >> SelectedResultLine is set >> switches to detail view.
                     AppName = entry name (bold); tooltip on it shows the category.
                     CountSummary = "3988 files · 2 registry" (gray, line 2).
                     Size = formatted bytes from the scan (accent, right). -->
                <ListView Grid.Row="1"
                          x:Name="ResultsListView"
                          ItemsSource="{x:Bind ViewModel.ResultLines, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ResultsListView_ItemClick"
                          Padding="0,2"
                          Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanResultLine">
                            <Grid Padding="12,7"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1"
                                  AutomationProperties.Name="{x:Bind AppName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /> <!-- size + chevron -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- AppName -->
                                    <RowDefinition Height="Auto" /> <!-- SubLine -->
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{x:Bind AppName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- "3988 files · 2 registry" -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{x:Bind CountSummary}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,1,0,0" />

                                <!-- Size in accent color + chevron to signal the row is clickable -->
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{x:Bind Size}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Detail list; flat "header + paths" list for the selected entry.
                     DetailLine.IsHeader = true : accent bold section title ("Files (10)")
                     DetailLine.IsHeader = false : dimmed path row; click opens folder in Explorer -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.DetailLines, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="DetailList_ItemClick"
                          Padding="0,2"
                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailLine">
                            <Grid Padding="12,3"
                                  AutomationProperties.Name="{x:Bind Text}">
                                <!-- Section header: "Files (3988)" or "Registry (2)" -->
                                <TextBlock Text="{x:Bind Text}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Margin="0,6,0,2"
                                           Visibility="{x:Bind IsHeader,
                                               Converter={StaticResource BoolToVisibilityConverter}}" />
                                <!-- Path row: full file path or registry key -->
                                <TextBlock Text="{x:Bind Text}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind IsNotHeader,
                                               Converter={StaticResource BoolToVisibilityConverter}}">
                                    <!-- Right-click to whitelist file or folder from cleaning -->
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="MenuExcludeFile"
                                                            Click="ExcludeFile_Click"
                                                            Tag="{x:Bind Text}" />
                                            <MenuFlyoutItem x:Uid="MenuExcludeFolder"
                                                            Click="ExcludeFolder_Click"
                                                            Tag="{x:Bind Text}" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Bottom Action & Status Bar -->
                <Grid Grid.Row="2"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="14,10,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status text: last message from the ViewModel -->
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource FC_CaptionStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <!-- Analyze: visible when idle; morphs into Cancel once a scan/clean starts -->
                        <Button x:Uid="BtnAnalyze"
                                Command="{x:Bind ViewModel.AnalyzeCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                MinWidth="100"
                                Height="32" />

                        <!-- Cancel: same slot, only visible during an active scan or clean -->
                        <Button x:Uid="BtnCancel"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                MinWidth="100"
                                Height="32" />

                        <!-- Run Cleaner: uses Click+code-behind because of the warning dialog flow -->
                        <Button x:Uid="BtnRunCleaner"
                                Click="RunCleaner_Click"
                                IsEnabled="{x:Bind ViewModel.CanRunCleaner, Mode=OneWay}"
                                MinWidth="110"
                                Height="32" />
                    </StackPanel>
                </Grid>
        </Grid>
    </Grid>
</Page>
