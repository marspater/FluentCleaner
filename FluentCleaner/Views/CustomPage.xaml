<Page
    x:Class="FluentCleaner.Views.CustomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentCleaner.Views"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Padding="32,24,32,16">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Uid="CustomTitle" Style="{StaticResource FC_PageTitleStyle}" />
                <TextBlock x:Name="lblStatus" Style="{StaticResource FC_CaptionStyle}" />
            </StackPanel>
        </Grid>

        <!-- empty state -->
        <StackPanel x:Name="panelEmpty" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="10">
            <FontIcon Glyph="&#xE8F4;" FontSize="36"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock x:Uid="CustomEmptyHint"
                       Style="{StaticResource FC_CardHeaderStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Uid="CustomEmptyHint2"
                       Style="{StaticResource FC_SubtextStyle}"
                       TextWrapping="WrapWholeWords" TextAlignment="Center"
                       MaxWidth="260" />
        </StackPanel>

        <!-- card grid -->
        <Grid x:Name="panelList" Grid.Row="1" Visibility="Collapsed">
            <ListView x:Name="listCustom" SelectionMode="None" Padding="24,0,24,80">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="164" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"   Value="Stretch" />
                        <Setter Property="Padding"    Value="0,0,10,10" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CustomEntryVm">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource FC_CardCornerRadius}"
                                Opacity="{x:Bind EnabledOpacity, Mode=OneWay}">
                            <Grid Padding="{StaticResource FC_DenseCardPadding}" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: name + ··· menu -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource FC_CardHeaderStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button x:Uid="BtnCustomActions"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource FC_SubtleIconButton}">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem x:Uid="MenuEditEntry" Tag="{x:Bind}" Click="Edit_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="MenuDeleteEntry" Tag="{x:Bind}" Click="Delete_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Middle: description (scripts) or status (INI) -->
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind Description}"
                                           Style="{StaticResource FC_CaptionStyle}" TextWrapping="Wrap"
                                           MaxLines="3" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top"
                                           Visibility="{x:Bind ScriptVisibility}" />
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind StatusText, Mode=OneWay}"
                                           Style="{StaticResource FC_CaptionStyle}"
                                           VerticalAlignment="Top"
                                           Visibility="{x:Bind IniVisibility}" />

                                <!-- Action: Run (scripts) or Toggle (INI) -->
                                <Button Grid.Row="2"
                                        Tag="{x:Bind}" Click="RunScript_Click"
                                        HorizontalAlignment="Center"
                                        Padding="20,5"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ScriptVisibility}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock x:Uid="BtnRunScript" />
                                    </StackPanel>
                                </Button>

                                <ToggleSwitch Grid.Row="2"
                                             IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                             HorizontalAlignment="Right"
                                             OnContent="" OffContent=""
                                             MinWidth="0"
                                             Visibility="{x:Bind IniVisibility}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
